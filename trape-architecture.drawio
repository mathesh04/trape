        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph Client[\&quot;Client Tier (Browser)\&quot;]\n        SPA[\&quot;React 18 + Vite Storefront (Port 5173)\&quot;]\n        ADMIN_UI[\&quot;Admin Management Console (/admin)\&quot;]\n    end\n\n    subgraph Security[\&quot;Edge &amp; Filter Pipeline\&quot;]\n        CORS[\&quot;CorsConfig (Origins, Methods, Headers)\&quot;]\n        SEC_FILTER[\&quot;Spring Security Filter Chain\&quot;]\n        JWT_FILTER[\&quot;JwtAuthFilter (Bearer Token Validation)\&quot;]\n    end\n\n    subgraph Backend[\&quot;Application Tier (Spring Boot 3.3.4 / Java 21)\&quot;]\n        direction TB\n        subgraph WebLayer[\&quot;Controllers (Presentation Layer)\&quot;]\n            AUTH_C[\&quot;AuthController\&quot;]\n            CAT_C[\&quot;ProductController\&quot;]\n            CART_C[\&quot;CartController\&quot;]\n            ORD_C[\&quot;OrderController\&quot;]\n            PAY_C[\&quot;PaymentController\&quot;]\n            ADM_C[\&quot;AdminProductController / AdminOrderController\&quot;]\n        end\n\n        subgraph ServiceLayer[\&quot;Services (Business Logic Layer)\&quot;]\n            AUTH_S[\&quot;AuthService\&quot;]\n            CAT_S[\&quot;ProductService\&quot;]\n            CART_S[\&quot;CartService\&quot;]\n            ORD_S[\&quot;OrderService\&quot;]\n            INV_S[\&quot;InventoryService\&quot;]\n            SM[\&quot;OrderStateMachine\&quot;]\n            RZP_S[\&quot;RazorpayService\&quot;]\n            CPN_S[\&quot;CouponService\&quot;]\n        end\n\n        subgraph RepoLayer[\&quot;Repositories (Data Access Layer)\&quot;]\n            AUTH_R[\&quot;UserRepository / RefreshTokenRepo\&quot;]\n            CAT_R[\&quot;ProductRepository / VariantRepo\&quot;]\n            INV_R[\&quot;InventoryRepository (Pessimistic Lock)\&quot;]\n            ORD_R[\&quot;OrderRepository / OrderItemRepo\&quot;]\n            PAY_R[\&quot;PaymentRepository\&quot;]\n            CART_R[\&quot;CartRepository / CartItemRepo\&quot;]\n        end\n    end\n\n    subgraph DataTier[\&quot;Data Tier\&quot;]\n        DB[(\&quot;PostgreSQL via Supabase (Port 5432)\&quot;)]\n        FLYWAY[\&quot;Flyway Migrations (V1 Init, V2 Seed)\&quot;]\n    end\n\n    subgraph External[\&quot;External Services\&quot;]\n        RZP[\&quot;Razorpay Payment Gateway (Orders API, Webhooks)\&quot;]\n    end\n\n    SPA --&gt;|REST API over JSON / Bearer JWT| CORS\n    ADMIN_UI --&gt;|REST API over JSON / Bearer JWT| CORS\n    CORS --&gt; SEC_FILTER --&gt; JWT_FILTER\n    JWT_FILTER --&gt; WebLayer\n    WebLayer --&gt; ServiceLayer\n    ServiceLayer --&gt; RepoLayer\n    RepoLayer --&gt; DB\n    FLYWAY -.-&gt;|Manages Schema &amp; Seeds| DB\n    ORD_S --&gt; RZP_S --&gt;|HTTPS / HMAC SHA-256| RZP\n    RZP --&gt;|Async Webhook: payment.captured| PAY_C&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DBMzQhY1KQfL8kG0J0es-1">
